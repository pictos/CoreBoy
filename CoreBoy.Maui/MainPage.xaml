<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="CoreBoy.Maui.MainPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:CoreBoy.Maui">
	<Grid
		Padding="10"
		ColumnDefinitions="1*, *"
		RowDefinitions="auto, *"
		RowSpacing="10">

		<local:ScreenView Grid.Row="0" Grid.ColumnSpan="2" />

		<Grid
			Grid.Row="1"
			ColumnDefinitions="auto, auto, auto"
			RowDefinitions="auto, auto, auto"
			VerticalOptions="Center">

			<Button
				Grid.Column="1"
				Clicked="UpClicked"
				HorizontalOptions="Center"
				Pressed="UpClicked"
				Text="Up" />
			<Button
				Grid.Row="1"
				Grid.Column="3"
				Clicked="RightClicked"
				HorizontalOptions="End"
				Pressed="RightClicked"
				Text="Right" />
			<Button
				Grid.Row="1"
				Clicked="LeftClicked"
				HorizontalOptions="Start"
				Pressed="LeftClicked"
				Text="Left" />
			<Button
				Grid.Row="2"
				Grid.Column="1"
				Clicked="DownClicked"
				HorizontalOptions="Center"
				Pressed="DownClicked"
				Text="Down"
				VerticalOptions="End" />
		</Grid>

		<Grid
			Grid.Row="1"
			Grid.Column="1"
			ColumnDefinitions="*, *"
			ColumnSpacing="10"
			RowDefinitions="auto, auto">
			<Button
				Clicked="AClicked"
				Pressed="AClicked"
				Text="A"
				VerticalOptions="Center" />
			<Button
				Grid.Column="1"
				Clicked="BClicked"
				Pressed="BClicked"
				Text="B"
				VerticalOptions="Center" />

			<Button
				Grid.Row="1"
				Clicked="StartClicked"
				Pressed="StartClicked"
				Text="Start" />
			<Button
				Grid.Row="1"
				Grid.Column="1"
				Clicked="SelectClicked"
				Pressed="SelectClicked"
				Text="Select" />
		</Grid>
	</Grid>

</ContentPage>
